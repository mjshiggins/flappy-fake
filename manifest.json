{
  "manifest_version": 3,
  "name": "Flappy Fake",
  "version": "0.1.0",
  "description": "Plays flappybird.io by searching the game's own simulation.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://flappybird.io/*"],
      "js": ["dist/main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
