{
  "manifest_version": 3,
  "name": "Flappy Fake",
  "version": "0.1.1",
  "description": "Plays flappybird.io by searching the game's own simulation.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://flappybird.io/*"],
      "js": ["dist/main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
